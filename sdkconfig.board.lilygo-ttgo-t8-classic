# LILYGO TTGO T8 with the classic ESP32-WROVER module and onboard microSD.
# This profile does not target the later ESP32-S2 product also sold as T8.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# PSRAM is a PocketArcade hardware requirement. Do not boot this profile when
# external RAM cannot be initialised.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

CONFIG_PA_AP_PASSWORD=""
CONFIG_PA_HTTP_MAX_URI_HANDLERS=36
CONFIG_PA_AVATAR_MAX_BYTES=12288
CONFIG_PA_SD_FORMAT_IF_UNMOUNTABLE=y

# CONFIG_PA_SD_DISABLED is not set
# CONFIG_PA_SD_SDMMC is not set
CONFIG_PA_SD_SDSPI=y
CONFIG_PA_SDSPI_HOST_SPI2=y
# CONFIG_PA_SDSPI_HOST_SPI3 is not set
CONFIG_PA_SD_CLOCK_KHZ=20000
CONFIG_PA_SDSPI_MOSI_PIN=14
CONFIG_PA_SDSPI_MISO_PIN=12
CONFIG_PA_SDSPI_CLK_PIN=27
CONFIG_PA_SDSPI_CS_PIN=33
CONFIG_PA_SD_CARD_DETECT_PIN=-1
CONFIG_PA_SD_POWER_PIN=-1

CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_PA_HTTP_MAX_OPEN_SOCKETS=7
CONFIG_PA_WS_MAX_CONNECTIONS=8
CONFIG_PA_WS_OUTBOUND_QUEUE_LENGTH=4
CONFIG_PA_GAME_MAX_SNAPSHOT_RATE_HZ=10
CONFIG_PA_GAME_LUA_CALLBACK_TIMEOUT_MS=50
