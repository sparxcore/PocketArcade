{
  "manifestVersion": 2,
  "id": "pocket-inferno",
  "name": "Pocket Inferno",
  "description": "Fast 2–4 player textured raycast arena combat. No bots, no waiting around.",
  "version": "0.1.13",
  "minPlatformVersion": "0.3.0",
  "kind": "game",
  "client": {
    "entrypoint": "client/app.js",
    "stylesheet": "client/app.css"
  },
  "runtime": {
    "type": "lua",
    "entrypoint": "server/main.lua",
    "mode": "tick",
    "tickRateHz": 15
  },
  "multiplayer": {
    "minPlayers": 2,
    "maxPlayers": 4,
    "spectators": true,
    "lateJoin": "spectator",
    "reconnectGraceMs": 30000
  },
  "protocol": {
    "version": 1
  },
  "capabilities": [
    "match.seats",
    "match.results"
  ]
}
