# AI-Thinker ESP32-A1S Audio Kit v2.2 carrier with onboard microSD.
# PocketArcade does not initialise either supported audio-codec population.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# The ESP32-A1S module includes PSRAM and PocketArcade requires it.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

CONFIG_PA_AP_PASSWORD=""
CONFIG_PA_HTTP_MAX_URI_HANDLERS=36
CONFIG_PA_AVATAR_MAX_BYTES=12288
CONFIG_PA_SD_FORMAT_IF_UNMOUNTABLE=y

# Use the native ESP32 SDMMC slot in 1-bit mode. The board's SD/JTAG DIP
# switches must route these signals to the card socket.
# CONFIG_PA_SD_DISABLED is not set
CONFIG_PA_SD_SDMMC=y
# CONFIG_PA_SD_SDSPI is not set
CONFIG_PA_SDMMC_WIDTH_1=y
# CONFIG_PA_SDMMC_WIDTH_4 is not set
CONFIG_PA_SD_CLOCK_KHZ=20000
CONFIG_PA_SDMMC_CLK_PIN=14
CONFIG_PA_SDMMC_CMD_PIN=15
CONFIG_PA_SDMMC_D0_PIN=2
CONFIG_PA_SD_CARD_DETECT_PIN=34
CONFIG_PA_SD_CARD_DETECT_ACTIVE_LOW=y
# CONFIG_PA_SD_CARD_DETECT_INTERNAL_PULL is not set
CONFIG_PA_SD_POWER_PIN=-1

CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_PA_HTTP_MAX_OPEN_SOCKETS=7
CONFIG_PA_WS_MAX_CONNECTIONS=8
CONFIG_PA_WS_OUTBOUND_QUEUE_LENGTH=4
CONFIG_PA_GAME_MAX_SNAPSHOT_RATE_HZ=10
CONFIG_PA_GAME_LUA_CALLBACK_TIMEOUT_MS=50
