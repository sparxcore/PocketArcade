# LILYGO TTGO T8-S3 v1.2 with ESP32-S3, 16 MB QIO flash, 8 MB QSPI
# PSRAM, onboard microSD, and native USB Serial/JTAG.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The v1.2 board uses external quad-SPI PSRAM rather than octal PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
# CONFIG_SPIRAM_MODE_OCT is not set
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

CONFIG_PA_AP_PASSWORD=""
CONFIG_PA_HTTP_MAX_URI_HANDLERS=36
CONFIG_PA_AVATAR_MAX_BYTES=12288
CONFIG_PA_SD_FORMAT_IF_UNMOUNTABLE=y

# CONFIG_PA_SD_DISABLED is not set
# CONFIG_PA_SD_SDMMC is not set
CONFIG_PA_SD_SDSPI=y
CONFIG_PA_SDSPI_HOST_SPI2=y
# CONFIG_PA_SDSPI_HOST_SPI3 is not set
CONFIG_PA_SD_CLOCK_KHZ=20000
CONFIG_PA_SDSPI_MOSI_PIN=11
CONFIG_PA_SDSPI_MISO_PIN=13
CONFIG_PA_SDSPI_CLK_PIN=12
CONFIG_PA_SDSPI_CS_PIN=10
CONFIG_PA_SD_CARD_DETECT_PIN=-1
CONFIG_PA_SD_POWER_PIN=21
CONFIG_PA_SD_POWER_ACTIVE_HIGH=y

CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_PA_HTTP_MAX_OPEN_SOCKETS=7
CONFIG_PA_WS_MAX_CONNECTIONS=8
CONFIG_PA_WS_OUTBOUND_QUEUE_LENGTH=4
CONFIG_PA_GAME_MAX_SNAPSHOT_RATE_HZ=10
CONFIG_PA_GAME_LUA_CALLBACK_TIMEOUT_MS=50
