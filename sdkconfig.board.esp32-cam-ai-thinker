# AI-Thinker ESP32-CAM (classic ESP32, onboard microSD slot).
# Use only when the module matches the AI-Thinker schematic.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# PocketArcade is intentionally open by default for quick local joining.
CONFIG_PA_AP_PASSWORD=""
CONFIG_PA_HTTP_MAX_URI_HANDLERS=36
CONFIG_PA_AVATAR_MAX_BYTES=12288
CONFIG_PA_SD_FORMAT_IF_UNMOUNTABLE=y

# CONFIG_PA_SD_DISABLED is not set
CONFIG_PA_SD_SDMMC=y
# CONFIG_PA_SD_SDSPI is not set
CONFIG_PA_SDMMC_WIDTH_1=y
# CONFIG_PA_SDMMC_WIDTH_4 is not set
CONFIG_PA_SD_CLOCK_KHZ=20000
CONFIG_PA_SDMMC_CLK_PIN=14
CONFIG_PA_SDMMC_CMD_PIN=15
CONFIG_PA_SDMMC_D0_PIN=2
CONFIG_PA_SD_CARD_DETECT_PIN=-1
CONFIG_PA_SD_POWER_PIN=-1
