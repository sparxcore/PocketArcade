# AI-Thinker ESP32-CAM (classic ESP32, onboard microSD slot).
# Use only when the module matches the AI-Thinker schematic.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Use onboard PSRAM when fitted, while retaining an internal-RAM fallback for
# compatible modules without it.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# PocketArcade is intentionally open by default for quick local joining.
CONFIG_PA_AP_PASSWORD=""
CONFIG_PA_HTTP_MAX_URI_HANDLERS=36
CONFIG_PA_AVATAR_MAX_BYTES=12288
CONFIG_PA_SD_FORMAT_IF_UNMOUNTABLE=y

# CONFIG_PA_SD_DISABLED is not set
CONFIG_PA_SD_SDMMC=y
# CONFIG_PA_SD_SDSPI is not set
CONFIG_PA_SDMMC_WIDTH_1=y
# CONFIG_PA_SDMMC_WIDTH_4 is not set
CONFIG_PA_SD_CLOCK_KHZ=20000
CONFIG_PA_SDMMC_CLK_PIN=14
CONFIG_PA_SDMMC_CMD_PIN=15
CONFIG_PA_SDMMC_D0_PIN=2
CONFIG_PA_SD_CARD_DETECT_PIN=-1
CONFIG_PA_SD_POWER_PIN=-1

# Keep enough bounded Wi-Fi buffering for four phones without starving the
# authoritative Lua runtime and snapshot serializer on internal-RAM boards.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_PA_HTTP_MAX_OPEN_SOCKETS=7
CONFIG_PA_WS_MAX_CONNECTIONS=8
CONFIG_PA_WS_OUTBOUND_QUEUE_LENGTH=4
CONFIG_PA_GAME_MAX_SNAPSHOT_RATE_HZ=10
CONFIG_PA_GAME_LUA_CALLBACK_TIMEOUT_MS=50
